// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Categories
model Category {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  slug      String   @unique
  description String?
  imageUrl  String?  @map("image_url")
  products  Product[]
  sizes     Size[]
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@map("categories")
}

// Products
model Product {
  id                String   @id @default(uuid()) @db.Uuid
  categoryId        String   @map("category_id") @db.Uuid
  category          Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name              String
  slug              String   @unique
  description       String?
  longDescription   String?  @map("long_description")
  basePrice         Decimal  @map("base_price") @db.Decimal(10, 2)
  salePrice         Decimal? @map("sale_price") @db.Decimal(10, 2)
  imageUrl          String?  @map("image_url")
  featured          Boolean  @default(false)
  active            Boolean  @default(true)
  variants          ProductVariant[]
  reviews           Review[]
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([categoryId])
  @@index([slug])
  @@map("products")
}

// Sizes
model Size {
  id            String   @id @default(uuid()) @db.Uuid
  categoryId    String   @map("category_id") @db.Uuid
  category      Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name          String
  displayOrder  Int?     @map("display_order")
  variants      ProductVariant[]
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("sizes")
}

// Colors
model Color {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @unique
  hexCode       String?  @map("hex_code")
  displayOrder  Int?     @map("display_order")
  variants      ProductVariant[]
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("colors")
}

// Materials
model Material {
  id            String   @id @default(uuid()) @db.Uuid
  name          String   @unique
  description   String?
  displayOrder  Int?     @map("display_order")
  variants      ProductVariant[]
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("materials")
}

// Product Variants (SKU-based)
model ProductVariant {
  id                      String   @id @default(uuid()) @db.Uuid
  productId               String   @map("product_id") @db.Uuid
  product                 Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sizeId                  String?  @map("size_id") @db.Uuid
  size                    Size?    @relation(fields: [sizeId], references: [id], onDelete: SetNull)
  colorId                 String?  @map("color_id") @db.Uuid
  color                   Color?   @relation(fields: [colorId], references: [id], onDelete: SetNull)
  materialId              String?  @map("material_id") @db.Uuid
  material                Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)
  sku                     String   @unique
  price                   Decimal  @db.Decimal(10, 2)
  cost                    Decimal? @db.Decimal(10, 2)
  quantityInStock         Int      @default(0) @map("quantity_in_stock")
  reorderLevel            Int      @default(10) @map("reorder_level")
  active                  Boolean  @default(true)
  inventoryTransactions   InventoryTransaction[]
  cartItems               CartItem[]
  orderItems              OrderItem[]
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([productId])
  @@index([sku])
  @@map("product_variants")
}

// Inventory Transactions
model InventoryTransaction {
  id                String   @id @default(uuid()) @db.Uuid
  variantId         String   @map("variant_id") @db.Uuid
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  transactionType   String   @map("transaction_type")
  quantity          Int
  referenceId       String?  @map("reference_id") @db.Uuid
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([variantId])
  @@map("inventory_transactions")
}

// Customers
model Customer {
  id              String   @id @db.Uuid
  email           String
  firstName       String?  @map("first_name")
  lastName        String?  @map("last_name")
  phone           String?
  isAdmin         Boolean  @default(false) @map("is_admin")
  addresses       Address[]
  carts           Cart[]
  orders          Order[]
  reviews         Review[]
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([email])
  @@map("customers")
}

// Addresses
model Address {
  id              String   @id @default(uuid()) @db.Uuid
  customerId      String   @map("customer_id") @db.Uuid
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type            String   // 'shipping' or 'billing'
  streetAddress   String   @map("street_address")
  city            String
  state           String
  postalCode      String   @map("postal_code")
  country         String
  isDefault       Boolean  @default(false) @map("is_default")
  orders          Order[]
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("addresses")
}

// Shopping Carts
model Cart {
  id              String   @id @default(uuid()) @db.Uuid
  customerId      String?  @map("customer_id") @db.Uuid
  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sessionId       String?  @map("session_id")
  items           CartItem[]
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  expiresAt       DateTime @map("expires_at") @db.Timestamp(6)

  @@index([customerId])
  @@map("carts")
}

// Cart Items
model CartItem {
  id              String   @id @default(uuid()) @db.Uuid
  cartId          String   @map("cart_id") @db.Uuid
  cart            Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId       String   @map("variant_id") @db.Uuid
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity        Int
  addedAt         DateTime @default(now()) @map("added_at") @db.Timestamp(6)

  @@unique([cartId, variantId])
  @@index([cartId])
  @@map("cart_items")
}

// Orders
model Order {
  id                  String   @id @default(uuid()) @db.Uuid
  customerId          String?  @map("customer_id") @db.Uuid
  customer            Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderNumber         String   @unique @map("order_number")
  status              String   @default("pending")
  subtotal            Decimal  @db.Decimal(10, 2)
  tax                 Decimal  @default(0) @db.Decimal(10, 2)
  shippingCost        Decimal  @default(0) @map("shipping_cost") @db.Decimal(10, 2)
  total               Decimal  @db.Decimal(10, 2)
  paymentStatus       String   @default("pending") @map("payment_status")
  paymentMethod       String?  @map("payment_method")
  shippingAddressId   String?  @map("shipping_address_id") @db.Uuid
  shippingAddress     Address? @relation(fields: [shippingAddressId], references: [id])
  trackingNumber      String?  @map("tracking_number")
  notes               String?
  // Guest checkout fields
  guestFirstName      String?  @map("guest_first_name")
  guestLastName       String?  @map("guest_last_name")
  guestWilaya         String?  @map("guest_wilaya")
  guestPhone          String?  @map("guest_phone")
  items               OrderItem[]
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([customerId])
  @@index([status])
  @@map("orders")
}

// Order Items
model OrderItem {
  id              String   @id @default(uuid()) @db.Uuid
  orderId         String   @map("order_id") @db.Uuid
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId       String   @map("variant_id") @db.Uuid
  variant         ProductVariant @relation(fields: [variantId], references: [id])
  quantity        Int
  unitPrice       Decimal  @map("unit_price") @db.Decimal(10, 2)
  subtotal        Decimal  @db.Decimal(10, 2)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([orderId])
  @@map("order_items")
}

// Reviews
model Review {
  id                String   @id @default(uuid()) @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId        String   @map("customer_id") @db.Uuid
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderItemId       String?  @map("order_item_id") @db.Uuid
  rating            Int
  title             String?
  content           String?
  helpfulCount      Int      @default(0) @map("helpful_count")
  verifiedPurchase  Boolean  @default(false) @map("verified_purchase")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([productId])
  @@index([customerId])
  @@map("reviews")
}

// Analytics Events
model AnalyticsEvent {
  id              String   @id @default(uuid()) @db.Uuid
  customerId      String?  @map("customer_id") @db.Uuid
  sessionId       String?  @map("session_id")
  eventType       String   @map("event_type")
  eventData       Json?    @map("event_data")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([customerId])
  @@index([createdAt])
  @@map("analytics_events")
}
